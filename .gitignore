node_modules/
/target
.env

# NOTE: Cargo.lock is intentionally committed. lw-app is a shipped binary, so
# the lockfile must be tracked to guarantee reproducible CI/release builds.
# (A floating lockfile let `time 0.3.48` drift in and break the build.)

# SQLite dev DB (used for sqlx compile-time query checking)
linewise.db
linewise.db-wal
linewise.db-shm

# Bundled FFmpeg libs (user-provided, not shipped)
/ffmpeg/

# Tailwind build artifact (regenerated by build.rs)
crates/lw-app/tailwind.generated.css

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Agent worktrees (live git worktrees — checking these in would nest the
# whole repo) and per-machine agent settings overrides.
.claude/worktrees/
.claude/settings.local.json
