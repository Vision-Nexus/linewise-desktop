{
  "schema_version": 1,
  "numeric": {
    "fps": {
      "target": 30.0,
      "recommend": {
        "min": 29.0,
        "max": 61.0,
        "message": "Frame rate {fps:.1}fps is {bound} the recommended {min:.0}-{max:.0}fps band (target {target:.0}fps)"
      },
      "accept": {
        "min": 20.0,
        "max": 70.0,
        "message": "Frame rate {fps:.1}fps is {bound} the {min:.0}-{max:.0}fps acceptance band"
      }
    },
    "bitrate_kbps": {
      "target": 12000,
      "recommend": {
        "min": 10000,
        "max": 20000,
