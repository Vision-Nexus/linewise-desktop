      },
      "accept": {
        "min": 8000,
        "max": 50000,
        "message": "Bitrate {bitrate} is {bound} the {min_mbps}-{max_mbps}Mbps acceptance band"
      }
    },
    "resolution": {
      "recommend": {
        "min_height": 720,
